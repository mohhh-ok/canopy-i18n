{
  "git": {
    "tagName": "${version}",
    "commitMessage": "chore: release ${version}",
    "requireCleanWorkingDir": true,
    "push": true
  },
  "npm": {
    "publish": true
  },
  "github": {
    "release": true,
    "autoGenerate": true
  },
  "hooks": {
    "before:init": ["bun run build", "bun run test"]
  }
}
