{
  "name": "canopy-i18n",
  "version": "0.8.2",
  "description": "The Type-Safe i18n library that your IDE will Love",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/adaptors/react/index.d.ts",
      "import": "./dist/adaptors/react/index.js",
      "default": "./dist/adaptors/react/index.js"
    },
    "./unstable_next": {
      "types": "./dist/adaptors/next/index.d.ts",
      "import": "./dist/adaptors/next/index.js",
      "default": "./dist/adaptors/next/index.js"
    }
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "skills/SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "type-check": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "GITHUB_TOKEN=\"$(gh auth token)\" node ./node_modules/release-it/bin/release-it.js"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "next": "16",
    "react": "^19.2.6",
    "release-it": "^19.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "messages",
    "template"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohhh-ok/canopy-i18n"
  }
}
